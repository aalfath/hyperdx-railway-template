<!-- ClickHouse settings for HyperDX on Railway. -->
<clickhouse>
    <!-- Log to the console only, so Railway shows the logs and no log files grow. -->
    <logger>
        <level>warning</level>
        <console>1</console>
        <log remove="remove"/>
        <errorlog remove="remove"/>
    </logger>

    <!-- Same as HyperDX's own ClickHouse config. -->
    <custom_settings_prefixes>hyperdx</custom_settings_prefixes>
    <timezone>UTC</timezone>

    <!-- ClickHouse's own diagnostic tables: off, or kept 3 days, so they can't fill the volume.
         Your telemetry tables have their own 30-day TTL (set by the collector). -->
    <trace_log remove="remove"/>
    <text_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <processors_profile_log remove="remove"/>
    <query_metric_log remove="remove"/>
    <query_thread_log remove="remove"/>
    <query_views_log remove="remove"/>
    <asynchronous_insert_log remove="remove"/>
    <opentelemetry_span_log remove="remove"/>
    <background_schedule_pool_log remove="remove"/>
    <query_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></query_log>
    <part_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></part_log>
    <error_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></error_log>
</clickhouse>
